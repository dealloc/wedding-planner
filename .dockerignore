# Keep the Docker build context small and the build reproducible — none of this is
# needed inside the image, and letting host artifacts leak in defeats the point of a
# clean multi-stage build (NFR-03's release tooling).
_build/
deps/
doc/
cover/
.fetch
erl_crash.dump
*.ez
*.db
*.db-*
tmp/

assets/node_modules/
priv/static/assets/
priv/static/cache_manifest.json
priv/static/uploads/

.git/
.gitignore
.github/
.vscode/
.claude/
.mcp.json

*.md
!README.md
