#!/bin/sh
# Periodic, ONE-WAY sync of the uploads directory to the backup bucket (NFR-04, D-32).
# Copied to <release_root>/bin/uploads-sync-loop by `mix release`'s automatic
# `rel/overlays` handling. Started in the background by bin/entrypoint; it runs for the
# lifetime of the container, alongside (but independently of) Litestream and the app.
#
# THE ASYMMETRY (read this before touching this file):
#   Litestream (litestream.yml, bin/entrypoint) replicates ONLY the SQLite WAL. It has
#   no idea the uploads directory exists. This script is the other, unrelated mechanism
#   NFR-04 requires for the uploaded files themselves.
#
#   This sync is one-way, local -> bucket, ALWAYS. The app never reads from the bucket
#   at request time (XC-23, D-32) — uploaded files are always served from
#   $UPLOADS_PATH on the local mounted volume. This loop is a backup path only. It is
#   not invoked automatically in the other direction; restoring the uploads directory
#   FROM the bucket is a deliberate, manual, documented disaster-recovery step (see
#   DEPLOY.md's restore drill), never something that happens on boot or on a timer.
#
# Schedule: every UPLOADS_SYNC_INTERVAL_SECONDS (default 900 = 15 minutes). Chosen
# because this app has exactly two users (NFR-03) uploading occasional invoice/offer
# files, not a stream of traffic — 15 minutes keeps the backup reasonably fresh without
# running an S3 LIST/sync cycle so often that it competes for I/O and API calls with the
# single shared-cpu-1x machine that also runs the app and Litestream. Tune via that env
# var (no rebuild needed) if that trade-off ever needs revisiting.
set -u

interval="${UPLOADS_SYNC_INTERVAL_SECONDS:-900}"

# Configure an rclone remote named "backup" purely from environment variables — no
# rclone config file exists anywhere in the image or repo, so credentials are never
# baked in (same bucket/credentials Litestream uses, see litestream.yml and DEPLOY.md).
# Passing credentials this way (rather than inline in the remote string below) also
# keeps them out of argv, and therefore out of `ps` output.
export RCLONE_CONFIG_BACKUP_TYPE=s3
export RCLONE_CONFIG_BACKUP_PROVIDER=Other
export RCLONE_CONFIG_BACKUP_ACCESS_KEY_ID="$BACKUP_ACCESS_KEY_ID"
export RCLONE_CONFIG_BACKUP_SECRET_ACCESS_KEY="$BACKUP_SECRET_ACCESS_KEY"
export RCLONE_CONFIG_BACKUP_ENDPOINT="$BACKUP_ENDPOINT"
export RCLONE_CONFIG_BACKUP_REGION="$BACKUP_REGION"

echo "uploads-sync-loop: will sync $UPLOADS_PATH -> backup:$BACKUP_BUCKET/uploads every ${interval}s"

while true; do
  sleep "$interval"

  if [ ! -d "$UPLOADS_PATH" ]; then
    echo "uploads-sync-loop: $UPLOADS_PATH does not exist yet, skipping this tick" >&2
    continue
  fi

  # `rclone sync` makes the destination match the source (local -> bucket only; rclone
  # never touches $UPLOADS_PATH itself in this direction). A failed tick is logged and
  # retried on the next one — it must never crash this loop or the container.
  if rclone sync "$UPLOADS_PATH" "backup:${BACKUP_BUCKET}/uploads" --checkers 4; then
    echo "uploads-sync-loop: sync completed"
  else
    echo "uploads-sync-loop: rclone sync failed (exit $?), will retry in ${interval}s" >&2
  fi
done
