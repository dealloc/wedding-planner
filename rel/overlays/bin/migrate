#!/bin/sh
# Standard migrate release command (NFR-03). Copied to <release_root>/bin/migrate by
# `mix release`'s automatic `rel/overlays` handling. Wired up as `release_command` in
# fly.toml, so it runs once, on its own machine, before a deploy's new version takes
# traffic — including against a completely fresh persistent volume.
set -eu

cd -- "$(dirname -- "$0")/.."

exec bin/wedding_planner eval "WeddingPlanner.Release.migrate()"
